# An ALLOWLIST: everything is excluded, then only the code the demo runs is
# let in. So no database, no .env, no key, no tool cache and no dashboard can
# reach the image by accident, whatever is lying around the working folder.
# Read from the repository root, the build context (fly.toml names it).
*
!package.json
!package-lock.json
!tsconfig.json
!src/
!src/**
!demo/
!demo/**
!scripts/arc-demo/
!scripts/arc-demo/**
!deploy/fly/entrypoint.sh
!deploy/fly/front.mjs
!dashboard/
!dashboard/**
**/node_modules
**/.env*
**/*.env
**/*.db
**/*.db.*
**/*.sqlite*
**/*.jsonl
**/*.key
**/*.pem
**/*.p8
**/*.p12
**/secrets/
**/.next
**/.claude-flow
**/tsconfig.tsbuildinfo
**/*.log
**/ruvector.db
