# Fireblocks sandbox — get these from your Fireblocks developer sandbox account.
# The key file lives under ./secrets/, which is gitignored (as are *.pem, *.key).
# Your workspace's Base Sepolia USDC asset id differs from ours: see README,
# "Run Fuel locally".
FIREBLOCKS_API_KEY=
FIREBLOCKS_PRIVATE_KEY_PATH=./secrets/fireblocks_sandbox_key.pem

# Database. Fuel runs on SQLite: one file, created and migrated on first start.
# Default: fuel.db in the repo root (gitignored, like every *.db and *.db.*).
# FUEL_DB_PATH=fuel.db
#
# DATABASE_URL is no longer read by anything. It dates from the planned
# Postgres setup; leave it out.

# x402 test endpoint — address that receives payments (the Fireblocks vault)
X402_PAY_TO=

# Throwaway TESTNET-ONLY payer wallet for the Phase 0 end-to-end test.
# Never put a key holding real funds here.
TEST_PAYER_PRIVATE_KEY=

# Two disjoint secrets for /api, sent as `Authorization: Bearer <key>`. Which
# key you present decides what you may do — the role is never self-declared.
# Generate each with `openssl rand -hex 32`.
#
# The server REFUSES TO BOOT if these two are equal: identical values would
# collapse the split back into one credential that can both spend and approve,
# which is the exact thing the split exists to prevent.

# Operator: sets company/team/agent caps, approves or denies held payments,
# creates teams and agents. Cannot make a payment. Used by the scripts in
# scripts/, which have no browser to sign in from. NOT by the dashboard.
FUEL_API_KEY=

# Agent: makes cap-checked payments (POST /api/agents/:id/pay). Cannot approve
# anything or change a cap. Shared across all agents for now — it identifies a
# role, not an individual agent. See docs/roadmap.md Phase 2 Slice 3.
FUEL_AGENT_KEY=

# THE DASHBOARD NO LONGER USES FUEL_API_KEY. As of Stage 3 Commit C it holds no
# API credential and forwards the session cookie of whoever is signed in. So
# dashboard/.env.local needs FUEL_API_URL, and FUEL_RELAY_KEY below.

# The sign-in relay key (ADR 0020). The SAME value goes here AND in
# dashboard/.env.local. It lets the dashboard tell Fuel which browser a sign-in
# or signup came from, so the rate limits count per browser instead of
# counting every browser as the dashboard. It is NOT an API credential: Fuel
# answers 401 to it as a Bearer token.
# Generate with `openssl rand -hex 32`. At least 32 characters, and different
# from FUEL_API_KEY and FUEL_AGENT_KEY, or the API refuses to start.
# Unset here: the relay is off, and limits count per caller as before. Unset in
# the dashboard: sign-in and signup refuse with "Fuel could not be reached".
# The dashboard must be started with `npm start` / `npm run dev` (server.mjs),
# never `next start` directly, or sign-in refuses the same way.
FUEL_RELAY_KEY=
# Optional. Which addresses the relay may arrive from (default 127.0.0.1,::1;
# set but empty means nobody), and the ceiling on relayed attempts per 15
# minutes across ALL browsers (default 500).
# FUEL_RELAY_PEERS=127.0.0.1,::1
# FUEL_RELAYED_CEILING=500
#
# NOTE ON BOTH KEYS, AS OF STAGE 3. They still work and every script here still
# uses them, but they name a ROLE and never a person. People sign in instead:
# POST /api/auth/login sets an HttpOnly session cookie, and a session carries a
# user id, so an approval can record who decided it. The keys are deliberately
# barred from the powers that create identities — they cannot mint an invite,
# manage users, or create a company. Nothing here needs setting for that; the
# first account is created by redeeming an invite.

# Whether the session cookie is marked `Secure`. DEFAULTS TO ON: a missing
# value in production has to be the safe one. Set it to exactly "false" for
# local development, where everything is plain http over loopback and a Secure
# cookie would never be sent back.
#
# It is read ONCE at boot and never derived from the request. An earlier version
# decided this from the Host header, which security review rejected: a reverse
# proxy forwarding to loopback without passing the original host makes every
# production request look local, and the cookie would quietly lose `Secure`.
#
# SET IT LOCALLY OR SIGN-IN WILL SILENTLY NOT WORK. This is not a nicety. With
# the default, the API sets `Secure` on the session cookie, the browser accepts
# the sign-in, and then refuses to send that cookie back over plain http — so
# every page bounces you to /login and nothing anywhere reports an error. It
# cost a debugging session in Stage 3 because the value was documented here and
# missing from the real .env.
FUEL_COOKIE_SECURE=false

# Encrypts the QuickBooks OAuth tokens before they are written to fuel.db.
# Generate with `openssl rand -hex 32` — exactly 32 bytes, 64 hex characters.
#
# Why this exists when nothing else in Fuel is encrypted at rest: every other
# secret here is compared, never stored. OAuth gives us tokens we must KEEP,
# and a database file gets copied to laptops, attached to bug reports and
# snapshotted into backups. A leaked fuel.db should not be a leaked accounting
# integration. Note this and the DB together are the whole secret — an attacker
# holding both has the tokens; it raises the bar from one artifact to two.
#
# Changing this value makes existing stored tokens undecryptable, which means
# reconnecting QuickBooks. Nothing else breaks.
FUEL_TOKEN_ENCRYPTION_KEY=

# QuickBooks Online — SANDBOX credentials, from developer.intuit.com.
# Create an app with the com.intuit.quickbooks.accounting scope, then take the
# keys from its *Development* (not Production) settings.
#
# The redirect URI must match what is registered on the app character for
# character, which is why it is configured rather than derived from the request.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/integrations/quickbooks/callback

# Environment
NODE_ENV=development

# Note: there is deliberately no mainnet toggle here. Enabling mainnet requires
# a reviewed code change, not an env edit. See CLAUDE.md "Non-negotiable rule".
#
# The same applies to QuickBooks: there is no variable selecting sandbox vs
# production. The API origin is pinned in src/quickbooks/config.ts and every
# outgoing URL is checked against it, so posting to a real company's books is
# also a reviewed code change rather than a config edit.

# scripts/qa-dashboard.ts signs into a real browser session, which since
# ADR 0018 needs a real account — it has no way to create one itself. These
# name a dedicated, idempotent test account (scripts/seed-qa-dashboard.ts) in
# its own company, never a real person's. No default password: that script
# resets the account to match whatever is set here, so choose one the way any
# other secret here is chosen (`openssl rand -hex 24`), not left blank.
# QA_DASHBOARD_COMPANY is the company's HANDLE, not its name — run
# `npm run seed-qa-dashboard` once, which prints it, and copy it here.
QA_DASHBOARD_COMPANY=
QA_DASHBOARD_EMAIL=qa-dashboard@fuel.local
QA_DASHBOARD_PASSWORD=

# NO VARIABLE CREATES THE FIRST ACCOUNT. Accounts exist only by redeeming an
# invite, and the invite that creates a company can only be minted by a script:
#
#   npx tsx scripts/mint-invite.ts --email you@example.com --new-company "Your Co"
#
# If you are ever locked out of an account you own, reset its password locally:
#
#   npx tsx scripts/set-password.ts --email you@example.com
#
# That script resets; it cannot create. It grants nothing that filesystem
# access to fuel.db does not already give you — it just computes a valid hash,
# which you cannot do at a shell prompt.

# ---------------------------------------------------------------------------
# Optional. Every other variable the code reads, with its default. None is a
# secret except the two origin-server values, which only the script below uses.
# ---------------------------------------------------------------------------

# The API's port.
# PORT=3000

# Where the dashboard is, for links Fuel builds: alert messages and the
# QuickBooks callback's redirect back to the dashboard. qa-dashboard also uses
# it to find the dashboard it tests.
# FUEL_DASHBOARD_URL=http://localhost:3100

# scripts/pay-test-endpoint.ts: the x402 endpoint the throwaway payer pays.
# X402_ENDPOINT=http://localhost:3000/paid-hello

# scripts/walk-accounting.ts: the dashboard it walks.
# WALK_DASHBOARD_URL=http://127.0.0.1:3101

# scripts/live-origin-server.ts, a local stand-in for a customer's origin in
# the earning flow. NONCE and SECRET have no default and must be set to run it.
# FUEL_ORIGIN_PORT=8899
# FUEL_ORIGIN_NONCE=
# FUEL_ORIGIN_SECRET=

# Do NOT set: FUEL_EDGE_PROOF. dashboard/server.mjs generates it fresh for
# every dashboard process (ADR 0020).
