FUEL_API_URL=http://127.0.0.1:3000

# The sign-in relay key (ADR 0020): the SAME value as FUEL_RELAY_KEY in the
# repo-root .env. It is not an API credential (Fuel answers 401 to it as a
# Bearer token). It only lets the dashboard say which browser a sign-in or
# signup came from. Without it, sign-in and signup refuse with "Fuel could not
# be reached".
FUEL_RELAY_KEY=

# NO API CREDENTIAL. The relay key above is the one narrow exception.
#
# FUEL_API_KEY used to be here, and every page was served with it — which meant
# every viewer of this dashboard acted as the same anonymous operator, and an
# approval could only ever record that "a human" decided. As of Stage 3 the
# dashboard forwards the session cookie of the person signed in, and Fuel
# resolves the company from THAT person's row.
#
# Do not add the key back. If a surface stops working without one, that is a
# surface calling Fuel outside the session path, and the fix is that surface.
